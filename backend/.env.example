# 德航智能经营驾驶舱 — 环境变量模板
# 复制为 .env 并填入实际值

# PostgreSQL
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/finance_cockpit

# 金蝶云星空 API
K3_BASE_URL=https://geshem.ik3cloud.com
K3_ACCT_ID=1783990801475402752
K3_USERNAME=your_kingdee_username
K3_PASSWORD=your_kingdee_password

# 企业微信 OAuth（到企业微信管理后台获取）
WECOM_CORP_ID=your_corp_id
WECOM_AGENT_ID=your_agent_id
WECOM_SECRET=your_secret
WECOM_REDIRECT_URI=https://cockpit.geshemsoft.com/api/auth/callback

# JWT
JWT_SECRET=your_random_secret_string

# CORS
CORS_ORIGINS=http://localhost:3000,https://cockpit.geshemsoft.com

# 定时同步
ENABLE_SCHEDULER=true
